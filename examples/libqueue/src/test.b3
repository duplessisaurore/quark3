@namespace test

@requires std::queue
@requires std

@entry main

@capability  breakpoint 2

@fn main ()
    !std::let queue = { !std::call std::queue::new ( {} ) }
    !std::assert (
        {
            !std::object_method { !std::get queue } -> std::queue::is_empty ( {} )
        }
    )

    !std::assert (
        {
            !std::uint_expr
            { !std::object_method { !std::get queue } -> std::queue::length ( {} ) }
            ==
            { !std::uint 0 }
        }
    )

    !std::object_method { !std::get queue } -> std::queue::push_back ( {
        !std::bool true
    } )

    !std::assert (
        {
            !std::uint_expr
            { !std::object_method { !std::get queue } -> std::queue::length ( {} ) }
            ==
            { !std::uint 1 }
        }
    )

    !std::let option_front_ref = { 
        !std::object_method { !std::get queue } -> std::queue::front_ref ( {} )
    }

    !std::assert (
        { 
            !std::object_method { !std::get option_front_ref } -> std::option::unwrap ( {} )
        }
    )

    !std::let option_front_ref = { 
        !std::object_method { !std::get queue } -> std::queue::front_ref ( {} )
    }

    !std::assert (
        { 
            !std::object_method { !std::get option_front_ref } -> std::option::unwrap ( {} )
        }
    )

    !std::assert (
        {
            !std::uint_expr
            { !std::object_method { !std::get queue } -> std::queue::length ( {} ) }
            ==
            { !std::uint 1 }
        }
    )

    !std::let option_pop_front = { 
        !std::object_method { !std::get queue } -> std::queue::pop_front ( {} )
    }

    !std::assert (
        { 
            !std::object_method { !std::get option_pop_front } -> std::option::unwrap ( {} )
        }
    )

    !std::assert (
        {
            !std::uint_expr
            { !std::object_method { !std::get queue } -> std::queue::length ( {} ) }
            ==
            { !std::uint 0 }
        }
    )

    !std::assert (
        {
            !std::object_method { !std::get queue } -> std::queue::is_empty ( {} )
        }
    )

    !std::return_void