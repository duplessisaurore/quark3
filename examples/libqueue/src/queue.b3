// queue.b3
//
// This contains a `Queue` type that builds upon an array

@namespace std::queue

@requires std
@requires std::option

// The one queue object
@object Queue (array)


// ## @fn std::queue::new
//
// ### Description
// Create a new empty queue
@fn new ()
    !std::return {
        !std::object_new self::Queue (
            { !std::array 0 ( {} ) }
        )
    }

// ## @fn std::queue::length <queue>
//
// ### Description
// Returns the length of the queue
//
// ### Arguments
// <queue>: The queue to get the length of
//
// ### Returns
// Length as a UInt
@fn length (queue)
    !std::let length = {
        !std::array_length {
            !std::object_get { !std::get queue } -> self::Queue.array
        }
    }

    !std::return { !std::get length }

// ## @fn std::queue::is_empty <queue>
//
// ### Description
// Returns whether or not the queue is empty
//
// ### Arguments
// <queue>: The queue to get the empty status of
//
// ### Returns
// The empty status as a Bool
@fn is_empty (queue)
    !std::return { 
        !std::uint_expr 
            { !std::object_method { !std::get queue } -> self::length ( { } ) }
            ==
            { !std::uint 0 }
    }


// ## @fn std::queue::push_back <queue> <item>
//
// ### Description
// Appends an item to the back of the queue
//
// ### Arguments
// <queue>: The queue to append the item to
@fn push_back (queue, item)
    !std::let queue_array = { !std::object_get { !std::get queue } -> self::Queue.array }
    
    !std::object_set { !std::get queue } -> self::Queue.array = { !std::array_append 
        // queue_array ++ [item]
        { !std::get queue_array }
        { !std::array 1 ( { !std::get item } )}
    }

    !std::return_void

// ## @fn std::queue::front_ref <queue>
//
// ### Description
// Returns a copy of the front of the queue without popping it off
//
// ### Arguments
// <queue>: The queue to get the item from
//
// ### Returns
// an liboption Option of the item potentially
@fn peek (queue)
    !std::let queue_array = { !std::object_get { !std::get queue } -> self::Queue.array }
    
    // if object is empty, return None
    !std::if ( { !std::object_method { !std::get queue } -> self::is_empty ( {} ) } ) {
        !std::return {
            !std::call std::option::new_none ( {} )
        }
    }

    // Otherwise the queue must have at least one item, so return that
    !std::return {
        !std::call std::option::new_some ( {
            !std::array_get { !std::get queue_array } [ { !std::uint 0 } ]
        } )
    }

// ## @fn std::queue::push_back <queue>
//
// ### Description
// Returns the front of the queue by popping it off
//
// ### Arguments
// <queue>: The queue to get the item from
//
// ### Returns
// an liboption Option of the item potentially
@fn pop_front (queue)
    !std::let queue_array = { !std::object_get { !std::get queue } -> self::Queue.array }
    
    // if object is empty, return None
    !std::if ( { !std::object_method { !std::get queue } -> self::is_empty ( {} ) } ) {
        !std::return {
            !std::call std::option::new_none ( {} )
        }
    }

    // Update the queue object to remove the item
    !std::object_set { !std::get queue } -> self::Queue.array = {
        !std::array_tail { !std::get queue_array }
    }

    // The queue must have at least one item, so return that
    !std::return {
        !std::call std::option::new_some ( {
            !std::array_head { !std::get queue_array }
        } )
    }