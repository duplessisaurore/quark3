// std.b3
//
// This file contains a set of Boson3 macros that form standard constructs
// found in other C-Like languages, and may serve as a good starting point for projects
// built ontop of Boson3
//
// This library has no dependencies and may be used anywhere.

@namespace std

// ## @macro std::int <literal>
//
// ### Description
// Pushes one Int literal as a value. This does not convert the value represented in the literal.
//
// ### Arguments
// <literal>: A single Int literal token accepted by push.int.
//
@macro int (literal)
    push.int $literal
@end

// ## @macro std::uint <literal>
//
// ### Description
// Pushes one UInt literal as a value. This does not convert the value represented in the literal.
//
// ### Arguments
// <literal>: A single UInt literal token accepted by push.uint.
//
@macro uint (literal)
    push.uint $literal
@end

// ## @macro std::float <literal>
//
// ### Description
// Pushes one Float literal as a value. This does not convert the value represented in the literal.
//
// ### Arguments
// <literal>: A single Float literal token accepted by push.float.
//
@macro float (literal)
    push.float $literal
@end

// ## @macro std::bool <literal>
//
// ### Description
// Pushes one Boolean literal as a value. This does not convert the value represented in the literal.
//
// ### Arguments
// <literal>: A single Boolean literal token accepted by push.bool.
//
@macro bool (literal)
    push.bool $literal
@end

// ## @macro std::unit
//
// ### Description
// Pushes the Unit value as an expression.
//
// ### Arguments
// None.
//
@macro unit ()
    push.unit
@end

// ## @macro std::get <name>
//
// ### Description
// Reads an existing, initialised local's value out.
//
// ### Arguments
// <name>: The local name in this function.
//
@macro get (name)
    load.local $name
@end

// ## @macro std::global_get <name>
//
// ### Description
// Reads an existing, initialised global's value out.
//
// ### Arguments
// <name>: The global's name.
//
@macro global_get (name)
    load.global $name
@end

// ## @macro std::let <name> = <rhs>
//
// ### Description
// Declares a local and initialises it with one value of any type.
//
// Evaluates rhs once and leaves no value.
//
// Locals are scoped to the current function, a new binding of the same
// name will be equivalent to a `set` assignment to that name.
//
// ### Arguments
// <name>: A new local name in the current function.
// <rhs>: The value to initialise the local with.
//
@macro let (name, operator, rhs)
    @matches operator ^=$
    @local $name
    $rhs
    store.local $name
@end

// ## @macro std::set <name> <operator> <rhs>
//
// ### Description
// Sets an existing local to a value. 
//
// This does not declare the local, it must be declared elsewhere such as with `std::let`.
// 
// = assigns any value without reading the previous value.
//
// +=, -=, *=, <<=, &=, |=, and ^= use generic Int/UInt operations, these
// require that the value stored in the local and the new rhs value are of
// the same type.
//
// Float values should use float_set instead.
//
// Compound assignment reads the old value before evaluating rhs once and combining
// them with an operator to produce the new value.
//
// Use int_set or uint_set for /=, %=, and >>= (these are special non-generic).
//
// ### Arguments
// <name>: The existing local name.
// <operator>: =, +=, -=, *=, <<=, &=, |=, or ^=.
// <rhs>: The value to update the local with.
//
@macro set (name, operator, rhs)
    @matches operator ^=$
    $rhs
    store.local $name
@end

@macro set (name, operator, rhs)
    @matches operator ^\+=$
    load.local $name
    $rhs
    numeric.add
    store.local $name
@end

@macro set (name, operator, rhs)
    @matches operator ^-=$
    load.local $name
    $rhs
    numeric.sub
    store.local $name
@end

@macro set (name, operator, rhs)
    @matches operator ^\*=$
    load.local $name
    $rhs
    numeric.mul
    store.local $name
@end

@macro set (name, operator, rhs)
    @matches operator ^<<=$
    load.local $name
    $rhs
    numeric.shift.left
    store.local $name
@end

@macro set (name, operator, rhs)
    @matches operator ^&=$
    load.local $name
    $rhs
    bitwise.and
    store.local $name
@end

@macro set (name, operator, rhs)
    @matches operator ^\|=$
    load.local $name
    $rhs
    bitwise.or
    store.local $name
@end

@macro set (name, operator, rhs)
    @matches operator ^\^=$
    load.local $name
    $rhs
    bitwise.xor
    store.local $name
@end

// ## @macro std::int_set <name> <operator> <rhs>
//
// ### Description
// Performs Int assignment or compound assignment on an existing local that should
// be of the Int type.
//
// This forwards all of the underlying `std::set` operations, and allows for the usage
// of >>=, %= and /= too.
//
// ### Arguments
// <name>: The existing local name.
// <operator>: Base `std::set` operators, and >>=, %= or /=.
// <rhs>: The value to update the local with.
//
@macro int_set (name, operator, rhs)
    @matches operator ^(=|\+=|-=|\*=|<<=|&=|\|=|\^=)$
    !std::set $name $operator { $rhs }
@end

@macro int_set (name, operator, rhs)
    @matches operator ^/=$
    load.local $name
    $rhs
    int.div
    store.local $name
@end

@macro int_set (name, operator, rhs)
    @matches operator ^%=$
    load.local $name
    $rhs
    int.mod
    store.local $name
@end

@macro int_set (name, operator, rhs)
    @matches operator ^>>=$
    load.local $name
    $rhs
    int.shift.right
    store.local $name
@end

// ## @macro std::uint_set <name> <operator> <rhs>
//
// ### Description
// Performs UInt assignment or compound assignment on an existing local that should
// be of the UInt type.
//
// This forwards all of the underlying `std::set` operations, and allows for the usage
// of >>=, %= and /= too.
//
// ### Arguments
// <name>: The existing local name.
// <operator>: Base `std::set` operators, and >>=, %= or /=.
// <rhs>: The value to update the local with.
//
@macro uint_set (name, operator, rhs)
    @matches operator ^(=|\+=|-=|\*=|<<=|&=|\|=|\^=)$
    !std::set $name $operator { $rhs }
@end

@macro uint_set (name, operator, rhs)
    @matches operator ^/=$
    load.local $name
    $rhs
    uint.div
    store.local $name
@end

@macro uint_set (name, operator, rhs)
    @matches operator ^%=$
    load.local $name
    $rhs
    uint.mod
    store.local $name
@end

@macro uint_set (name, operator, rhs)
    @matches operator ^>>=$
    load.local $name
    $rhs
    uint.shift.right
    store.local $name
@end

// ## @macro std::float_set <name> <operator> <rhs>
//
// ### Description
// Performs Float assignment or compound assignment on an existing local that should
// be of the Float type.
//
// This permits for the operations of =, +=, -=, *=, /=, %=, where = is the same
// underlying `std::set` operation.
//
// ### Arguments
// <name>: The existing local name.
// <operator>: =, +=, -=, *=, /= or %=.
// <rhs>: The value to update the local with.
//
@macro float_set (name, operator, rhs)
    @matches operator ^(=)$
    !std::set $name $operator { $rhs }
@end

@macro float_set (name, operator, rhs)
    @matches operator ^\+=$
    load.local $name
    $rhs
    float.add
    store.local $name
@end

@macro float_set (name, operator, rhs)
    @matches operator ^-=$
    load.local $name
    $rhs
    float.sub
    store.local $name
@end

@macro float_set (name, operator, rhs)
    @matches operator ^\*=$
    load.local $name
    $rhs
    float.mul
    store.local $name
@end

@macro float_set (name, operator, rhs)
    @matches operator ^/=$
    load.local $name
    $rhs
    float.div
    store.local $name
@end

@macro float_set (name, operator, rhs)
    @matches operator ^%=$
    load.local $name
    $rhs
    float.mod
    store.local $name
@end

// ## @macro std::global_set <name> <operator> <rhs>
//
// ### Description
// Sets an existing global to a value. 
//
// This does not declare the global, it must be declared elsewhere such as with the `@global` directive.
// 
// = assigns any value without reading the previous value.
//
// +=, -=, *=, <<=, &=, |=, and ^= use generic Int/UInt operations, these
// require that the value stored in the local and the new rhs value are of
// the same type.
//
// Float values should use float_global_set instead.
//
// Compound assignment reads the old value before evaluating rhs once and combining
// them with an operator to produce the new value.
//
// Use int_global_set or uint_global_set for /=, %=, and >>= (these are special non-generic).
//
// ### Arguments
// <name>: The existing global name.
// <operator>: =, +=, -=, *=, <<=, &=, |=, or ^=.
// <rhs>: The value to update the global with.
//
@macro global_set (name, operator, rhs)
    @matches operator ^=$
    $rhs
    store.global $name
@end

@macro global_set (name, operator, rhs)
    @matches operator ^\+=$
    load.global $name
    $rhs
    numeric.add
    store.global $name
@end

@macro global_set (name, operator, rhs)
    @matches operator ^-=$
    load.global $name
    $rhs
    numeric.sub
    store.global $name
@end

@macro global_set (name, operator, rhs)
    @matches operator ^\*=$
    load.global $name
    $rhs
    numeric.mul
    store.global $name
@end

@macro global_set (name, operator, rhs)
    @matches operator ^<<=$
    load.global $name
    $rhs
    numeric.shift.left
    store.global $name
@end

@macro global_set (name, operator, rhs)
    @matches operator ^&=$
    load.global $name
    $rhs
    bitwise.and
    store.global $name
@end

@macro global_set (name, operator, rhs)
    @matches operator ^\|=$
    load.global $name
    $rhs
    bitwise.or
    store.global $name
@end

@macro global_set (name, operator, rhs)
    @matches operator ^\^=$
    load.global $name
    $rhs
    bitwise.xor
    store.global $name
@end


