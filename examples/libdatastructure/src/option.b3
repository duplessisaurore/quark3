// option.b3
//
// This contains an `Option` type that can be
// empty None or Some(Any)

@namespace std::option

@requires std

// The two variants of option
@object Some (item)
@object None ()

// ## @fn std::option::new_some
// Create a new option object with Some
@fn new_some (item)
    !std::return { 
        !std::object_new self::Some ( { !std::get item } )
    }

// ## @fn std::option::new_some
// Create a new option object with None
@fn new_none (item)
    !std::return { 
        !std::object_new self::None ( { } )
    }

// ## @macro std::option::match <option> Some ( <item_name> ) => <some_body> None => <none_body>
// 
@macro match (option, some, open, item_binding, close, =>, some_body, none_arrow, none_body)
    @matches some ^Some$
    @matches open ^\($
    @matches close ^\)$
    @matches => ^=>$
    @matches none_arrow ^None\s+=>$
    object.type.tag self::Some
    $option
    type.of
    

    %some_match:

    jump %after
    %none_match:

    %after:
@end